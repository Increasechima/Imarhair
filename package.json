{
  "name": "imarhair",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @imarhair/web dev",
    "dev:mobile": "pnpm --filter @imarhair/mobile start",
    "build": "pnpm --filter @imarhair/web build",
    "start": "pnpm --filter @imarhair/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:types:remote": "node scripts/gen-types.mjs",
    "verify:remote": "node scripts/verify-remote/run.mjs",
    "dev:reseed-catalog": "node scripts/dev/reseed-catalog.mjs",
    "dev:catalog-images": "node scripts/dev/catalog-images.mjs",
    "verify:e2e": "node scripts/verify-remote/e2e.mjs && node scripts/verify-remote/e2e-checkout.mjs && node scripts/verify-remote/e2e-admin.mjs",
    "verify:e2e:admin": "node scripts/verify-remote/e2e-admin.mjs",
    "verify:e2e:checkout": "node scripts/verify-remote/e2e-checkout.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0"
  },
  "packageManager": "pnpm@12.9.1"
}
