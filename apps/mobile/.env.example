# Copy to .env.local and fill in. Everything here ships inside the app, so only public values.
# Same Supabase project as the website (apps/web/.env.local NEXT_PUBLIC_* values).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The website: the app calls its /api/v1 routes and opens its checkout.
# On a phone, use your computer's LAN address (e.g. http://192.168.1.20:3000), not localhost.
EXPO_PUBLIC_SITE_URL=http://localhost:3000
