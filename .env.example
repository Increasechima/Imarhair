# Copy to .env.local and fill in. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# "paystack" for real payments. "mock" = development-only test payment page (no keys, no money);
# refused on the live deployment, and in production builds unless ALLOW_MOCK_PAYMENTS=true.
PAYMENT_PROVIDER=paystack
ALLOW_MOCK_PAYMENTS=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
EMAIL_FROM="Imarhair <orders@imarhair.com>"
EMAIL_TRANSPORT=log

SUPPORT_EMAIL=
SUPPORT_PHONE=

# Local Google OAuth via supabase/config.toml only (prod: set in Supabase dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session-pooler connection string (Dashboard → Connect → Session pooler), password URL-encoded.
# Used only by the Supabase CLI (db push) and pnpm verify:*. Never used by the app.
SUPABASE_DB_URL=
# pnpm verify:* creates and deletes test users. It runs only when this equals the project ref
# in NEXT_PUBLIC_SUPABASE_URL. Set it for dev/staging projects only, never production.
VERIFY_REMOTE_PROJECT_REF=
